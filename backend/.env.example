# Copy to .env and fill in. The installer does this for you and reuses your old keys.

# ---- Brain -------------------------------------------------------------
# auto = local model if it is running, otherwise Groq.  local / groq force one.
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Local model (Ollama). Install with: bash scripts/install-local-model.sh
LOCAL_MODEL=llama3.2:3b
LOCAL_VISION_MODEL=moondream
OLLAMA_URL=

# ---- Optional services -------------------------------------------------
NEWSDATA_KEY=
YOUTUBE_API_KEY=
GITHUB_USERNAME=
GITHUB_TOKEN=
WHATSAPP_DEFAULT_NUMBER=
# name=/path,name2=/path2   (used by "open my project" and "project status")
PROJECT_PATHS=

USER_NAME=Nemin
NEWS_COUNTRY=in

# ---- v15 extras (all optional) ------------------------------------------
# What Jarvis and Friday call you (Edith never does)
ADDRESS_AS=boss
# Smart home through Home Assistant: lights, switches, fans, scenes
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Part of your honeypot's Docker container name ("what is the honeypot doing?")
HONEYPOT_CONTAINER=honeypot
# Folders she may search and read, comma separated (empty = your Windows Documents, Downloads, Desktop)
FILES_ROOTS=
# Fixed timezone like Asia/Kolkata (empty = use the one your browser reports)
TIMEZONE=

# ---- v16 studio (all optional) -------------------------------------------
# Where models and creations are stored, e.g. your external SSD. Set it with:
#   bash scripts/studio-setup.sh /mnt/d/NemiiiStudio
MODELS_ROOT=
COMFY_URL=
TTS_VOICE=af_heart
MIN_FREE_GB=3
