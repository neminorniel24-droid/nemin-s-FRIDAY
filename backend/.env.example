# Copy to .env and fill in. The installer does this for you and reuses your old keys.

# ---- Brain -------------------------------------------------------------
# auto = local model if it is running, otherwise Groq.  local / groq force one.
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Local model (Ollama). Install with: bash scripts/install-local-model.sh
LOCAL_MODEL=llama3.2:3b
LOCAL_VISION_MODEL=moondream
OLLAMA_URL=

# ---- Optional services -------------------------------------------------
NEWSDATA_KEY=
YOUTUBE_API_KEY=
GITHUB_USERNAME=
GITHUB_TOKEN=
WHATSAPP_DEFAULT_NUMBER=
# name=/path,name2=/path2   (used by "open my project" and "project status")
PROJECT_PATHS=

USER_NAME=Nemin
NEWS_COUNTRY=in
